<view class="app-shell">
  <view class="status-space" style="height:{{statusBar}}px"></view>
  <view class="app-header"><view class="brand"><view class="brand-icon"><image src="/assets/paw.png" /></view><text>喵喵账本</text><view class="brand-dot"></view></view></view>
  <view class="account-switch" aria-label="选择账本"><button class="account-option {{account === 'personal' ? 'active' : ''}}" data-account="personal" bindtap="switchAccount"><image src="/assets/cat.png"/><text>个人消费</text></button><button class="account-option {{account === 'public' ? 'active' : ''}}" data-account="public" bindtap="switchAccount"><image src="/assets/book.png"/><text>公账</text></button></view>
  <view class="main">
    <view class="page-title-row"><view><view class="eyebrow">{{tab === 'home' ? 'A LITTLE EVERY DAY' : tab === 'bills' ? 'LIFE IN LITTLE NUMBERS' : tab === 'stats' ? 'KNOW YOUR LITTLE HABITS' : 'YOUR COZY CORNER'}}</view><view class="page-title">{{tab === 'home' ? '把日子，记得可爱一点' : tab === 'bills' ? '每一笔，都算数' : tab === 'stats' ? '看看钱都去哪儿了' : '我的小小账本'}}<text class="title-dot">.</text></view></view></view>
    <view class="month-row"><view class="month-switch"><view class="month-arrow" bindtap="previousMonth"><image src="/assets/arrowLeft.png"/></view><picker mode="date" fields="month" value="{{month}}" start="2000-01" end="2100-12" bindchange="changeMonth"><view class="month-label">{{vm.monthLabel}}<image src="/assets/chevron.png"/></view></picker><view class="month-arrow" bindtap="nextMonth"><image src="/assets/arrow.png"/></view></view><view class="local-badge"><view></view>本地安心记录</view></view>
    <block wx:if="{{tab === 'home'}}">
      <view class="hero-card"><view class="hero-copy"><view class="hero-label">本月支出 <view class="tiny-dot"></view></view><view class="hero-amount"><text>¥</text>{{vm.expenseText}}</view><view class="hero-message">认真生活的每一笔，都值得记录。</view></view><image class="hero-cat" src="/assets/mascot.png" mode="aspectFit"/><view class="hero-bottom"><view><text class="hero-small-label">本月收入</text><view class="hero-sub-amount"><text>¥</text> {{vm.incomeText}}</view></view><view class="hero-divider"></view><view><text class="hero-small-label">本月结余</text><view class="hero-sub-amount"><text>¥</text> {{vm.balanceText}}</view></view><view class="hero-bottom-paw"><image src="/assets/paw.png"/></view></view></view>
      <view class="budget-card" bindtap="openBudget"><view class="budget-top"><view class="budget-title"><image src="/assets/wallet.png"/><text>{{accountName}}预算</text></view><view class="budget-remaining {{vm.overBudget ? 'negative' : ''}}"><block wx:if="{{vm.hasBudget}}">{{vm.overBudget ? '已超支' : '还可花'}} <text>¥ {{vm.remainingText}}</text></block><text wx:else="">设置预算 ›</text><image src="/assets/arrow.png"/></view></view><view class="progress-track"><view class="progress-fill {{vm.overBudget ? 'over' : ''}}" style="width:{{vm.budgetPercent}}%"></view></view><view class="budget-meta"><text>{{vm.hasBudget ? '已用 ' + vm.budgetPercent + '%' : '尚未设置预算'}}</text><text>{{vm.hasBudget ? '月预算 ¥ ' + vm.budgetText : '点击设置当前账本预算'}}</text></view></view>
      <view class="section-heading"><view>最近账单<text class="section-count">{{vm.count}} 笔</text></view><view class="text-link" bindtap="allBills">查看全部<image src="/assets/arrow.png"/></view></view>
      <view wx:if="{{vm.groups.length === 0}}" class="empty-state"><image src="/assets/empty-cat.png"/><view class="empty-title">{{vm.isCurrentMonth ? '今天的故事，从第一笔开始' : '这个月，账本还是空白的'}} </view><view class="empty-desc">点下方「＋」，收好生活的小细节</view><button class="small-button" bindtap="addEntry">记下第一笔</button></view>
      <view class="bill-groups"><block wx:for="{{vm.recentGroups}}" wx:key="date" wx:for-item="group"><view class="day-heading"><view><text class="day-label">{{group.label}}</text><text class="day-week">{{group.weekday}}</text></view><view class="day-total"><text wx:if="{{group.expense}}">支出 {{group.expenseText}}</text><text wx:if="{{group.income}}"> 收入 {{group.incomeText}}</text></view></view><view class="bill-card"><view wx:for="{{group.rows}}" wx:key="id" class="bill-row" data-id="{{item.id}}" bindtap="editEntry"><view class="category-icon" style="background:{{item.color}}"><image src="/assets/{{item.icon}}.png"/></view><view class="bill-info"><view class="bill-category">{{item.categoryName}}</view><view class="bill-note">{{item.note || '生活里的小记录'}}</view></view><view class="bill-amount {{item.type === 'income' ? 'income' : ''}}">{{item.sign}}{{item.displayAmount}}</view></view></view></block></view>
      <view class="daily-note"><image src="/assets/paw.png"/><text>不必每一笔都完美，记下来就很棒。</text></view>
    </block>
    <block wx:elif="{{tab === 'bills'}}">
      <view class="mini-summary"><view><text>本月支出</text><view>¥ {{vm.expenseText}}</view></view><view><text>本月收入</text><view class="income">¥ {{vm.incomeText}}</view></view></view>
      <view class="search-box"><image src="/assets/search.png"/><input value="{{query}}" placeholder="搜索分类或备注" bindinput="search" maxlength="40"/></view>
      <view class="filter-row"><view class="filter {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setFilter">全部账单</view><view class="filter {{filter === 'expense' ? 'active' : ''}}" data-filter="expense" bindtap="setFilter">只看支出</view><view class="filter {{filter === 'income' ? 'active' : ''}}" data-filter="income" bindtap="setFilter">只看收入</view></view>
      <view wx:if="{{vm.groups.length === 0}}" class="empty-state"><image src="/assets/empty-cat.png"/><view class="empty-title">{{query ? '没有找到这笔小记录' : '这里还没有账单喵'}} </view><view class="empty-desc">{{query ? '换个关键词试试看' : '换个月份，或记下新的一笔'}}</view></view>
      <view class="bill-groups"><block wx:for="{{vm.groups}}" wx:key="date" wx:for-item="group"><view class="day-heading"><view><text class="day-label">{{group.label}}</text><text class="day-week">{{group.weekday}}</text></view><view class="day-total"><text wx:if="{{group.expense}}">支出 {{group.expenseText}}</text><text wx:if="{{group.income}}"> 收入 {{group.incomeText}}</text></view></view><view class="bill-card"><view wx:for="{{group.rows}}" wx:key="id" class="bill-row" data-id="{{item.id}}" bindtap="editEntry"><view class="category-icon" style="background:{{item.color}}"><image src="/assets/{{item.icon}}.png"/></view><view class="bill-info"><view class="bill-category">{{item.categoryName}}</view><view class="bill-note">{{item.note || '生活里的小记录'}}</view></view><view class="bill-amount {{item.type === 'income' ? 'income' : ''}}">{{item.sign}}{{item.displayAmount}}</view></view></view></block></view>
    </block>
    <block wx:elif="{{tab === 'stats'}}">
      <view class="stats-top"><view class="stat-card"><image src="/assets/bowl.png"/><text>本月支出</text><view>¥ {{vm.expenseText}}</view></view><view class="stat-card sage"><image src="/assets/sun.png"/><text>日均支出</text><view>¥ {{vm.dailyText}}</view></view></view>
      <view class="chart-card" wx:if="{{vm.isCurrentMonth}}"><view class="section-heading"><view>近 7 天支出</view><text class="subtle">单位：元</text></view><view class="bar-chart"><view wx:for="{{vm.week}}" wx:key="date" class="bar-column"><view class="bar-value">{{item.amount ? item.amountText : ''}}</view><view class="bar-track"><view class="bar {{item.label === '今' ? 'today' : ''}}" style="height:{{item.height}}%"></view></view><text>{{item.label}}</text></view></view></view>
      <view class="section-heading"><view>支出排行榜</view><text class="subtle">按分类统计</text></view><view wx:if="{{!vm.ranking.length}}" class="empty-state"><image src="/assets/empty-cat.png"/><view class="empty-title">还没有支出，继续保持喵</view><view class="empty-desc">记录支出后，就能看到分类占比</view></view>
      <view class="ranking-card" wx:if="{{vm.ranking.length}}"><view wx:for="{{vm.ranking}}" wx:key="id" class="rank-row"><view class="category-icon" style="background:{{item.color}}"><image src="/assets/{{item.icon}}.png"/></view><view class="rank-info"><view class="rank-top"><text>{{item.name}} <text class="rank-percent">{{item.percent}}%</text></text><text>¥ {{item.amountText}}</text></view><view class="rank-track"><view style="width:{{item.width}}%;background:{{item.color}}"></view></view></view></view></view>
      <view class="daily-note"><image src="/assets/spark.png"/><text>了解自己的小习惯，让每一笔更有方向。</text></view>
    </block>
    <block wx:else="">
      <view class="profile-card"><view class="profile-avatar"><image src="/assets/cat.png"/></view><view><view class="profile-name">认真生活的铲屎官</view><view class="profile-desc">好好记账，慢慢变富。</view></view><view class="profile-flower">✳</view></view>
      <view class="profile-numbers"><view><view>{{vm.totalCount}}<text> 笔</text></view><text>收好的小记录</text></view><view><view>{{vm.activeDays}}<text> 天</text></view><text>有记录的日子</text></view></view>
      <view class="settings-card"><view class="settings-row" bindtap="openBudget"><image src="/assets/wallet.png"/><text>月度预算</text><view>¥ {{vm.budgetText}}</view><image class="chevron-icon" src="/assets/arrow.png"/></view><view class="settings-row" bindtap="exportBook"><image src="/assets/download.png"/><text>导出当前账本</text><view>CSV 表格</view><image class="chevron-icon" src="/assets/arrow.png"/></view><view class="settings-row" bindtap="showPrivacy"><image src="/assets/shield.png"/><text>数据与隐私</text><view>本地存储</view><image class="chevron-icon" src="/assets/arrow.png"/></view><view class="settings-row" bindtap="clearBook"><image src="/assets/trash.png"/><text>清空当前账本</text><image class="chevron-icon" src="/assets/arrow.png"/></view></view>
      <view class="profile-footer"><image src="/assets/paw.png"/><view>喵喵账本</view><text>给认真生活的你 · v{{version}}</text></view>
    </block>
  </view>
  <view class="bottom-nav"><view class="nav-item {{tab === 'home' ? 'selected' : ''}}" data-tab="home" bindtap="switchTab"><image src="/assets/home.png"/><text>首页</text><view class="nav-dot"></view></view><view class="nav-item {{tab === 'bills' ? 'selected' : ''}}" data-tab="bills" bindtap="switchTab"><image src="/assets/book.png"/><text>账单</text><view class="nav-dot"></view></view><button class="nav-add" aria-label="记一笔" hover-class="nav-add-pressed" bindtap="addEntry"><image src="/assets/plus.png"/><text>记一笔</text></button><view class="nav-item {{tab === 'stats' ? 'selected' : ''}}" data-tab="stats" bindtap="switchTab"><image src="/assets/chart.png"/><text>统计</text><view class="nav-dot"></view></view><view class="nav-item {{tab === 'mine' ? 'selected' : ''}}" data-tab="mine" bindtap="switchTab"><image src="/assets/cat.png"/><text>我的</text><view class="nav-dot"></view></view></view>
  <view wx:if="{{editor || budgetEditor}}" class="modal-mask" bindtap="closeEditor"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="entry-account"><image src="/assets/book.png"/><text>当前账本 · {{accountName}}</text></view><view class="sheet-header"><view>{{budgetEditor ? '给这个月定个小目标' : form.id ? '编辑这笔小记录' : '记下生活的小事'}}</view><view class="close-button" aria-label="关闭记账面板" bindtap="closeEditor"><image src="/assets/close.png"/></view></view>
    <block wx:if="{{editor}}"><view class="type-switch"><view class="{{form.type === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="setType">支出</view><view class="{{form.type === 'income' ? 'active' : ''}}" data-type="income" bindtap="setType">收入</view></view><view class="amount-input"><text>¥</text><input type="digit" value="{{form.amount}}" placeholder="0.00" maxlength="12" bindinput="inputAmount" adjust-position="{{true}}"/></view><scroll-view class="category-scroll" scroll-y="{{true}}"><view class="category-grid"><view wx:for="{{categories}}" wx:key="id" class="category-option {{form.category === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="setCategory"><view class="category-icon" style="background:{{form.category === item.id ? '#f8d86e' : item.color}}"><image src="/assets/{{item.icon}}.png"/></view><text>{{item.name}}</text></view></view></scroll-view><picker class="date-picker" mode="date" value="{{form.date}}" start="2000-01-01" end="2100-12-31" bindchange="inputDate"><view class="form-row date-row"><image src="/assets/calendar.png"/><text>日期</text><view class="date-value">{{form.date}}<text class="picker-arrow">›</text></view></view></picker><view class="form-row"><image src="/assets/book.png"/><text>备注</text><input value="{{form.note}}" placeholder="为这笔记录加点故事" maxlength="40" bindinput="inputNote"/></view><button class="primary-button" bindtap="saveEntry">{{form.id ? '保存修改' : '记好啦'}}<image src="/assets/paw.png"/></button><button wx:if="{{form.id}}" class="delete-button" bindtap="deleteEntry">删除这笔记录</button><view wx:else="" class="sheet-footnote">小小一笔，也是在认真生活。</view></block>
    <block wx:else=""><view class="budget-help">每个月都留一点余地，给生活的小惊喜。<text>仅适用于{{accountName}}的每个月；输入 0 可取消预算。</text></view><view class="amount-input"><text>¥</text><input type="digit" value="{{budgetInput}}" placeholder="0.00" maxlength="12" bindinput="inputBudget"/></view><button class="primary-button" bindtap="saveBudget">就这样定啦<image src="/assets/check.png"/></button></block>
  </view></view>
</view>