.type-switch>view{min-height:88rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx}
.filter{min-height:88rpx;display:flex;align-items:center;justify-content:center}
.text-link{min-height:88rpx;min-width:120rpx;justify-content:flex-end}
.small-button,.demo-button,.delete-button{min-height:88rpx}
.primary-button{min-height:104rpx}
.sheet-header{margin-bottom:20rpx}

/* Minimum CSS-pixel targets also apply to narrow phones. */
.close-button,.month-arrow{min-width:44px;min-height:44px}
